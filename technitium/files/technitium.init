#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later

START=35
STOP=20
USE_PROCD=1

start_service() {
	# Package installation must preserve the administrator's service state.
	if [ "${pkgname:-}" = technitium ]; then
		[ "${PKG_UPGRADE:-}" = 1 ] && [ -f /tmp/technitium-upgrade.running ] || return 0
	fi
	if [ ! -s /etc/technitium/data/dns.config ] &&
		netstat -ln 2>/dev/null | awk '$1 ~ /^(tcp|udp)/ && $4 ~ /:53$/ { found=1 } END { exit !found }'; then
		logger -t technitium 'DNS port 53 is already in use. Configure the existing resolver before starting Technitium.'
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/lib/technitium/run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}
