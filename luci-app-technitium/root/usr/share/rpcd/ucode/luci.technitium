'use strict';

import { connect } from 'ubus';
import { lsdir, readfile, readlink } from 'fs';

const service = '/etc/init.d/technitium';
const actions = ['start', 'stop', 'restart', 'enable', 'disable'];

// Match the service's TCP/UDP listener pairs by socket inode to report its
// active DNS ports.
function dns_ports(instances) {
	const sockets = {};
	for (let name in instances) {
		const pid = int(instances[name].pid);
		if (!instances[name].running || !(pid > 0))
			continue;
		const directory = '/proc/' + pid + '/fd/';
		for (let fd in lsdir(directory) || []) {
			const socket = match(readlink(directory + fd), /^socket:\[(\d+)\]$/);
			if (socket)
				sockets[socket[1]] = true;
		}
	}
	const tcp = {};
	const udp = {};
	for (let protocol in ['tcp', 'tcp6', 'udp', 'udp6']) {
		for (let line in split(readfile('/proc/net/' + protocol) || '', '\n')) {
			const fields = split(trim(line), /\s+/);
			if (!sockets[fields[9]])
				continue;
			const port = int(split(fields[1], ':')[1], 16);
			if ((protocol === 'tcp' || protocol === 'tcp6') && fields[3] === '0A')
				tcp[port] = true;
			if ((protocol === 'udp' || protocol === 'udp6') && fields[3] === '07')
				udp[port] = true;
		}
	}
	return sort(map(filter(keys(udp), (port) => tcp[port]), (port) => int(port)), (a, b) => a - b);
}

return {
	'luci.technitium': {
		status: {
			call: function() {
				const bus = connect();
				const services = bus?.call('service', 'list', { name: 'technitium' });
				const instances = services?.technitium?.instances || {};
				let running = false;
				for (let name in instances)
					if (instances[name].running === true)
						running = true;

				return {
					running,
					port_conflict: !running && system("test ! -s /etc/technitium/data/dns.config && netstat -ln 2>/dev/null | awk '$1 ~ /^(tcp|udp)/ && $4 ~ /:53$/ { found=1 } END { exit !found }'") === 0,
					enabled: system(service + ' enabled >/dev/null 2>&1') === 0,
					console_port: 5380,
					dns_ports: dns_ports(instances)
				};
			}
		},
		control: {
			args: { action: '' },
			call: function(request) {
				const action = request.args.action;
				if (index(actions, action) < 0)
					return { success: false };

				let success = system(service + ' ' + action + ' >/dev/null 2>&1') === 0;
				if (success && (action === 'start' || action === 'restart'))
					success = system('sleep 1; ' + service + ' running >/dev/null 2>&1') === 0;
				return { success };
			}
		}
	}
};
